    },
    {
      "page": "/configuration-settings",
      "regex": "^/configuration\\-settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/configuration\\-settings(?:/)?$"
    },
    {
      "page": "/error-404",
      "regex": "^/error\\-404(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/error\\-404(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
